<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Vendored Agentic.Blocks packages (see .agentic/decisions/0003-vendored-building-blocks.md) -->
    <add key="vendored-blocks" value="eng/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="vendored-blocks">
      <package pattern="Agentic.Blocks.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
